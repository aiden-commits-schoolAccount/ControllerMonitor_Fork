<Window
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ControllerMonitor"
    x:Class="ControllerMonitor.ChangeLanguageWindow"
    Title="Change Language"
    Width="400"
    Height="320"
    MinWidth="200"
    MinHeight="200"
    Background="Transparent"
    TransparencyLevelHint="Transparent"
    WindowDecorations="Full"
    Topmost="True">

    <ScrollViewer Margin="20">
        <StackPanel x:Name="LanguageButtonsPanel" Spacing="8" />
    </ScrollViewer>
</Window>