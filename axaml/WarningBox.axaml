<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ControllerMonitor" x:Class="ControllerMonitor.WarningBox" Title="Settings" Width="600" SizeToContent="Height" Background="Transparent" TransparencyLevelHint="Transparent" WindowDecorations="Full" Topmost="True">
    <Grid RowDefinitions="Auto,Auto" Margin="20">
        <TextBlock x:Name="Message" Grid.Row="0" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16" Margin="0,0,0,20" />
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*">
            <Button Grid.Column="0" x:Name = "ExitButton" Content="Exit" Click="Exit_Click" Margin="0,0,10,0" HorizontalAlignment="Stretch" />
            <Button Grid.Column="1" x:Name = "SkipButton" Content="Skip" Click="Skip_Click" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" x:Name = "RetryButton" Content="Retry" Click="Retry_Click" Margin="10,0,0,0" HorizontalAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
<!--this is what happends when I use the format button... so compact wow-->